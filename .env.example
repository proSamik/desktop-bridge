# desktop-bridge configuration. Copy to .env in the install directory and edit.
# Every variable is optional; defaults are shown. Keep in sync with src/config.ts.

# Display name of this machine (consent page, admin panel tabs, notifications). Default: hostname.
MB_NODE_NAME=<machine-name>

# guarded = intent review + strict MCP allowlist + policy prompt (default)
# open    = no review; runs use your normal Claude Code / Codex config with full permissions
MB_PROFILE=guarded

# panel = serve the admin web UI (password + TOTP) and manage remotes (default)
# api   = key-protected admin API only; managed from a panel machine over an SSH forward
MB_ADMIN_UI=panel

# Public URL of this machine's tunnel hostname (OAuth issuer + resource). Required for Claude connectors.
MB_PUBLIC_URL=https://<mcp-hostname.your-domain>

# Ports (always bound to 127.0.0.1). Only the MCP port is routed by the tunnel.
MB_MCP_PORT=8787
MB_ADMIN_PORT=8788

# Max runs executing at the same time (1-10). Unset = panel setting (default 6). Setting it here locks the panel field.
# MB_MAX_CONCURRENT_RUNS=6

# Install directory. Default: the working directory the service starts in.
# MB_ROOT=/path/to/desktop-bridge

# Panel machine only: remotes to manage, name=url of each remote's admin API (usually an SSH forward).
# MB_REMOTES=<remote-name>=http://127.0.0.1:18798,<other-remote>=http://127.0.0.1:18799

# macOS only: Keychain service name that holds the secrets.
# MB_KEYCHAIN_SERVICE=desktop-bridge

# Desktop notifications (new runs, clients, connection requests). 0 = off, e.g. for test copies on other ports.
# MB_NOTIFY=1

# Optional binary overrides (auto-detected otherwise).
# MB_CLAUDE_BIN=/path/to/claude
# MB_CODEX_BIN=/path/to/codex

# ---------------------------------------------------------------------------
# Secrets are NOT set here. They live in the macOS Keychain (service above) or in <install dir>/secrets/<name>:
#   admin-password-hash, totp-secret   panel login            -> npm run setup
#   admin-api-key                      api machines           -> npm run setup -- api-key
#   remote-key-<name>                  panel: a remote's key  -> npm run setup -- remote-key <name>
#   env-<VAR>                          ${VAR} in allowed-mcp  -> npm run setup -- mcp-env
#   tunnel-token                       token-run tunnel       -> node scripts/cloudflare-tunnel.mjs ...
# Runtime settings (kill switch, max concurrent runs, allow subagents, rate limit, permission mode, Codex sandbox, IP allowlist, review model)
# are changed in the admin panel -> Settings.
